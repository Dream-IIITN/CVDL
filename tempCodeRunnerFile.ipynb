def get_iou(a,b):
    ax1, ay1, ax2, ay2 = a
    bx1, by1, bx2, by2 = b
    left = max(ax1,bx1)
    top = max(ay1,by1)
    right = min(ax2,bx2)
    bottom = min(ay2,by2)
    # edge case box no overlap
    if (left>right) or (bottom < top):
        return "no verlap"
    a_area = abs(ax2-ax1)*abs(ay2-ay1)
    b_area = abs(bx2-bx1)*abs(by2-by1)
    intersection_area = abs(left-right)*abs(top-bottom)
    union_area = a_area + b_area - intersection_area
    final_iou = intersection_area / union_area
    return final_iou